<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_stamp_nav</name>
  <version>1.0.0</version>
  <description>A Stochastic Topological Adaptive Motion Planner (STAMP) that constructs a 2D navigation trajectory from c-space optimized splines. Splines are tuned by simulated annealing and stochastic exploration of the local c-space.</description>
  <maintainer email="55628349+Matthew-Papesh@users.noreply.github.com">Matthew Papesh</maintainer>
  <license>Apache-2.0</license>

  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
